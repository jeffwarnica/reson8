---
apiVersion: image.openshift.io/v1
kind: ImageStream
metadata:
  name: ubi10-openjdk-21
  namespace: ${TARGET_NS}
spec:
  lookupPolicy:
    local: true
  tags:
    - name: latest
      from:
        kind: DockerImage
        name: registry.access.redhat.com/ubi10/openjdk-21:latest
      importPolicy:
        scheduled: true
      referencePolicy:
        type: Local
