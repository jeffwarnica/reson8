package com.coherentnetworksolutions.reson8.audio.input;

import io.smallrye.config.ConfigMapping;
import io.smallrye.config.WithDefault;
import java.util.Map;
import java.util.Optional;

public interface SoundDefinition {
    // The logical name (e.g., "stream", "wind")
    String name();

    // The category (e.g., "loop", "drop", "procedural")
    String type();

    // This captures the 'config:' block in your YAML
    // It will contain keys like 'filename' or 'type' (the class name)
    Map<String, String> config();

    // For nested procedural configs, we can use a raw map or a sub-interface
    // If the YAML has 'config.config', we map it here:
    @WithDefault("{}")
    Map<String, String> subConfig();
}