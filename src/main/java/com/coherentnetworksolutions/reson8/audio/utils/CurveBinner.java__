package com.coherentnetworksolutions.reson8.audio.utils;

import java.util.Comparator;
import java.util.List;

import com.coherentnetworksolutions.reson8.manager.config.Reson8Config;

public class CurveBinner {
    private final List<Reson8Config.CurvePoint> sortedPoints;
    // private final boolean extrapolate;

    public CurveBinner(Reson8Config.CurveConfig config) {
        // Sort points by input once at startup
        this.sortedPoints = config.points().stream()
                .sorted(Comparator.comparingDouble(Reson8Config.CurvePoint::input))
                .toList();
        // this.extrapolate = config.extrapolate();
    }

    public double transform(double val) {
        if (sortedPoints.isEmpty())
            return val;

        // Handle lower bound
        if (val <= sortedPoints.get(0).input())
            return sortedPoints.get(0).output();

        // Handle upper bound (Clamp or Extrapolate)
        var last = sortedPoints.get(sortedPoints.size() - 1);
        if (val >= last.input()) {
            return extrapolate ? last.output() : last.output(); // Simplify for POC
        }

        // Find the segment
        for (int i = 0; i < sortedPoints.size() - 1; i++) {
            var p1 = sortedPoints.get(i);
            var p2 = sortedPoints.get(i + 1);
            if (val >= p1.input() && val <= p2.input()) {
                // Linear Interpolation: y = y1 + (x - x1) * (y2 - y1) / (x2 - x1)
                double t = (val - p1.input()) / (p2.input() - p1.input());
                return p1.output() + t * (p2.output() - p1.output());
            }
        }
        return val;
    }
}