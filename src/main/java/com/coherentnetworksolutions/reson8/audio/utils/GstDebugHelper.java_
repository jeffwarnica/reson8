package com.coherentnetworksolutions.reson8.audio.utils;

import jakarta.inject.Inject;
import jakarta.inject.Singleton;
import org.freedesktop.gstreamer.*;
import org.freedesktop.gstreamer.message.MessageType;

import com.coherentnetworksolutions.reson8.audio.engine.Mixer;

import io.quarkus.logging.Log;

@Singleton
public class GstDebugHelper {

    @Inject
    Mixer mixer; // your existing singleton holding the pipeline

    public void debugInit() {
        Log.info("I'm in GstDebugHelper.onStart()");
        Log.infof("btw, I think GST_DEBUG_DUMP_DOT_DIR is [%s]", System.getenv("GST_DEBUG_DUMP_DOT_DIR"));
        Bus bus = mixer.getPipeline().getBus();

        bus.connect((Bus.MESSAGE) (b, msg) -> {
            if (msg.getType() == MessageType.ERROR) {

                Log.info("⚠️ GStreamer ERROR from: " + msg.getSource());
                Log.info("Details: " + msg.getStructure());

                // Force a state bounce to trigger DOT dump
                State current = mixer.getPipeline().getState();
                mixer.getPipeline().setState(State.PAUSED);
                mixer.getPipeline().setState(current);

                Log.info("Triggered DOT dump via state change");
            }
        });
    }

}