package com.coherentnetworksolutions.reson8.audio.utils.map;

import java.util.List;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

import com.coherentnetworksolutions.reson8.audio.utils.map.SignalMapper.Point;

import jakarta.enterprise.context.ApplicationScoped;

@ApplicationScoped
public class MapperRegistry {
    // Cache of immutable mappers
    private final Map<String, SignalMapper> cache = new ConcurrentHashMap<>();

    public SignalMapper getOrCreate(String configId, List<Point> points) {
        return cache.computeIfAbsent(configId, id -> new SplineSignalMapper(points));
    }
}